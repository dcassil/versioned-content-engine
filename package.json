{
  "name": "versioned-content-engine",
  "version": "0.0.0",
  "description": "Headless, zero-runtime-dependency pure TypeScript engine for versioned content materialization.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Cassil <me@danielcassil.com>",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/adapters/memory/index.d.ts",
      "import": "./dist/adapters/memory/index.js"
    },
    "./json": {
      "types": "./dist/adapters/json/index.d.ts",
      "import": "./dist/adapters/json/index.js"
    },
    "./sql": {
      "types": "./dist/adapters/sql/index.d.ts",
      "import": "./dist/adapters/sql/index.js"
    },
    "./react": {
      "types": "./dist/adapters/react/index.d.ts",
      "import": "./dist/adapters/react/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run bench/materialize.bench.ts",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^2.1.8",
    "dependency-cruiser": "^16.4.2",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
